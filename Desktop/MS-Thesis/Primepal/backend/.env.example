APP_ENV=development
SECRET_KEY=change-me-in-production

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/primepal

# Qdrant (Vector DB)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=snc_curriculum

# OpenAI
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o

# Speech-to-Text (Whisper via OpenAI)
WHISPER_MODEL=whisper-1

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Student JWT (custom secret — NOT Supabase JWT secret)
STUDENT_JWT_SECRET=generate-a-strong-random-secret

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis
REDIS_URL=redis://localhost:6379

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
